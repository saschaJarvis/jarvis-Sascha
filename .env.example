# Jarvis Sascha – Umgebungsvariablen (Vorlage)
# Diese Datei als .env.local kopieren und Werte im eigenen Passwort-Manager / Hosting-Secret-Store pflegen.
# NIEMALS echte Werte committen, in einen Chat kopieren oder in Issues posten.

# --- Supabase (Pflicht ab P0) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # öffentlicher anon-Key (durch RLS geschützt)
SUPABASE_SERVICE_ROLE_KEY=           # NUR serverseitig (Worker, Upload-Link-Einlösung). Nie im Browser.

# --- App ---
APP_BASE_URL=http://localhost:3000
APP_ENV=development                  # development | staging | production
DEMO_MODE=true                       # true = Demo-Daten sichtbar, kein echter Versand möglich
TOKEN_ENCRYPTION_KEY=                # 32 Byte base64 für OAuth-Token-Verschlüsselung (ab P3), z. B. `openssl rand -base64 32`

# --- E-Mail-Versand (ab P1 für Erinnerungen an dich selbst) ---
RESEND_API_KEY=
RESEND_FROM="Jarvis <jarvis@deine-domain.tld>"   # verifizierte Absenderdomain nötig
NOTIFY_TEST_RECIPIENT=                           # eigene Testadresse

# --- KI (ab P3; nur mit Datenminimierung) ---
ANTHROPIC_API_KEY=

# --- Später (P3/P4) – erst anlegen, wenn die Integration gebaut wird ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Lokale DB-Tests ---
PGHOST=/tmp
PGPORT=54322
PGUSER=postgres
