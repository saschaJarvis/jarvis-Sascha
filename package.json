{
  "name": "jarvis-sascha",
  "version": "0.1.0",
  "private": true,
  "description": "Persönliches Betriebssystem für Sascha – Umzug Mainz → Dubai und danach. Deutsch zuerst, mobil zuerst.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:db && npm run test:parity",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:db": "bash scripts/db-test.sh",
    "test:parity": "tsx scripts/check-transition-parity.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test:e2e": "playwright test",
    "db:local": "bash scripts/db-local.sh",
    "screens": "SCREENS=1 playwright test screens"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ical.js": "2.2.1",
    "next": "16.4.3",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "suncalc": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/suncalc": "1.9.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
